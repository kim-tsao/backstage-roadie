{
  "name": "@backstage/plugin-techdocs-backend-dynamic",
  "version": "2.2.1",
  "description": "The Backstage backend plugin that renders technical documentation for your components",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "techdocs",
    "pluginPackages": [
      "@backstage/plugin-techdocs",
      "@backstage/plugin-techdocs-backend",
      "@backstage/plugin-techdocs-common",
      "@backstage/plugin-techdocs-node",
      "@backstage/plugin-techdocs-react"
    ],
    "peerModules": [
      "@backstage/plugin-search-backend-module-techdocs"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage",
    "techdocs"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/techdocs-backend"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./alpha": {
      "require": "./dist/alpha.cjs.js",
      "types": "./dist/alpha.d.ts",
      "default": "./dist/alpha.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config.d.ts",
    "alpha"
  ],
  "dependencies": {
    "@backstage/plugin-techdocs-node": "^1.15.1",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.0",
    "fs-extra": "^11.2.0",
    "knex": "^3.0.0",
    "p-limit": "^3.1.0",
    "winston": "^3.2.1"
  },
  "configSchema": "config.d.ts",
  "bundleDependencies": true,
  "peerDependencies": {
    "@backstage/backend-plugin-api": "^1.9.2",
    "@backstage/catalog-client": "^1.16.0",
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/config": "^1.3.8",
    "@backstage/errors": "^1.3.1",
    "@backstage/integration": "^2.0.3",
    "@backstage/integration-aws-node": "^0.2.0",
    "@backstage/plugin-catalog-node": "^2.2.2",
    "@backstage/plugin-search-common": "^1.2.24",
    "@backstage/types": "^1.2.2"
  },
  "overrides": {
    "@aws-sdk/util-utf8-browser": {
      "@smithy/util-utf8": "^2.0.0"
    }
  },
  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "GendocuPublicApis": "npm:gendocu-public-apis@^1.0.0",
    "csstype@npm:^3.0.2": "3.0.9",
    "csstype@npm:^3.1.2": "3.0.9",
    "csstype@npm:^3.1.3": "3.0.9",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "@backstage/plugin-catalog-node": "2.2.2",
    "@backstage/plugin-catalog-common": "1.1.10",
    "@backstage/plugin-techdocs-node": "file:./embedded/backstage-plugin-techdocs-node",
    "@backstage/plugin-techdocs-common": "file:./embedded/backstage-plugin-techdocs-common",
    "cpu-features": "file:./embedded/cpu-features"
  }
}
