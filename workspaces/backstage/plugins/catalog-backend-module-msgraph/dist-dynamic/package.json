{
  "name": "@backstage/plugin-catalog-backend-module-msgraph-dynamic",
  "version": "0.10.3",
  "description": "A Backstage catalog backend module that helps integrate towards Microsoft Graph",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/catalog-backend-module-msgraph"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./alpha": {
      "require": "./dist/alpha.cjs.js",
      "types": "./dist/alpha.d.ts",
      "default": "./dist/alpha.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "files": [
    "config.d.ts",
    "dist",
    "alpha"
  ],
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@backstage/plugin-catalog-common": "^1.1.10",
    "@backstage/plugin-catalog-node": "^2.2.2",
    "@microsoft/microsoft-graph-types": "^2.6.0",
    "lodash": "^4.17.21",
    "p-limit": "^3.0.2",
    "qs": "^6.15.2"
  },
  "configSchema": "config.d.ts",
  "bundleDependencies": true,
  "peerDependencies": {
    "@backstage/backend-plugin-api": "^1.9.2",
    "@backstage/backend-test-utils": "^1.11.4",
    "@backstage/catalog-client": "^1.16.0",
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/config": "^1.3.8",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-permission-common": "^0.9.9",
    "@backstage/plugin-permission-node": "^0.11.1",
    "@backstage/plugin-search-common": "^1.2.24",
    "@backstage/types": "^1.2.2"
  },
  "overrides": {
    "@aws-sdk/util-utf8-browser": {
      "@smithy/util-utf8": "^2.0.0"
    }
  },
  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "GendocuPublicApis": "npm:gendocu-public-apis@^1.0.0",
    "csstype@npm:^3.0.2": "3.0.9",
    "csstype@npm:^3.1.2": "3.0.9",
    "csstype@npm:^3.1.3": "3.0.9",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "@backstage/plugin-catalog-common": "file:./embedded/backstage-plugin-catalog-common",
    "@backstage/plugin-catalog-node": "file:./embedded/backstage-plugin-catalog-node"
  }
}
