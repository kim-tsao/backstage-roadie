{
  "name": "@backstage/plugin-kubernetes-dynamic",
  "version": "0.12.20",
  "description": "A Backstage plugin that integrates towards Kubernetes",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "kubernetes",
    "pluginPackages": [
      "@backstage/plugin-kubernetes",
      "@backstage/plugin-kubernetes-backend",
      "@backstage/plugin-kubernetes-common",
      "@backstage/plugin-kubernetes-node",
      "@backstage/plugin-kubernetes-react"
    ],
    "features": {
      "./alpha": "@backstage/FrontendPlugin"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage",
    "kubernetes"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/kubernetes"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {},
    "./alpha": {},
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "dist-scalprum"
  ],
  "dependencies": {
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/core-components": "^0.18.11",
    "@backstage/core-plugin-api": "^1.12.7",
    "@backstage/frontend-plugin-api": "^0.17.2",
    "@backstage/plugin-catalog-react": "^3.1.0",
    "@backstage/plugin-kubernetes-common": "^0.9.12",
    "@backstage/plugin-kubernetes-react": "^0.5.20",
    "@backstage/plugin-permission-react": "^0.5.2",
    "@material-ui/core": "^4.12.2"
  },
  "peerDependencies": {
    "@types/react": "^17.0.0 || ^18.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "overrides": {
    "@aws-sdk/util-utf8-browser": {
      "@smithy/util-utf8": "^2.0.0"
    }
  },
  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "GendocuPublicApis": "npm:gendocu-public-apis@^1.0.0",
    "csstype@npm:^3.0.2": "3.0.9",
    "csstype@npm:^3.1.2": "3.0.9",
    "csstype@npm:^3.1.3": "3.0.9",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "@backstage/plugin-kubernetes-common": "0.9.12"
  }
}
