{
  "name": "@backstage/plugin-techdocs-dynamic",
  "version": "1.17.7",
  "description": "The Backstage plugin that renders technical documentation for your components",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "techdocs",
    "pluginPackages": [
      "@backstage/plugin-techdocs",
      "@backstage/plugin-techdocs-backend",
      "@backstage/plugin-techdocs-common",
      "@backstage/plugin-techdocs-node",
      "@backstage/plugin-techdocs-react"
    ],
    "features": {
      "./alpha": "@backstage/FrontendPlugin"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage",
    "techdocs"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/techdocs"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {},
    "./alpha": {},
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "config.d.ts",
    "dist-scalprum"
  ],
  "dependencies": {
    "@backstage/catalog-client": "^1.16.0",
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/config": "^1.3.8",
    "@backstage/core-components": "^0.18.11",
    "@backstage/core-plugin-api": "^1.12.7",
    "@backstage/errors": "^1.3.1",
    "@backstage/frontend-plugin-api": "^0.17.2",
    "@backstage/integration": "^2.0.3",
    "@backstage/integration-react": "^1.2.19",
    "@backstage/plugin-auth-react": "^0.1.28",
    "@backstage/plugin-catalog-react": "^3.1.0",
    "@backstage/plugin-search-common": "^1.2.24",
    "@backstage/plugin-search-react": "^1.11.5",
    "@backstage/plugin-techdocs-common": "^0.1.1",
    "@backstage/plugin-techdocs-react": "^1.3.12",
    "@backstage/theme": "^0.7.3",
    "@backstage/ui": "^0.16.0",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "4.0.0-alpha.61",
    "@material-ui/styles": "^4.10.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "dompurify": "^3.3.2",
    "git-url-parse": "^15.0.0",
    "lodash": "^4.17.21",
    "react-helmet": "6.1.0",
    "react-use": "^17.2.4",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@types/react": "^17.0.0 || ^18.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "configSchema": "config.d.ts",
  "overrides": {
    "@aws-sdk/util-utf8-browser": {
      "@smithy/util-utf8": "^2.0.0"
    }
  },
  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "GendocuPublicApis": "npm:gendocu-public-apis@^1.0.0",
    "csstype@npm:^3.0.2": "3.0.9",
    "csstype@npm:^3.1.2": "3.0.9",
    "csstype@npm:^3.1.3": "3.0.9",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "@backstage/plugin-techdocs-common": "0.1.1"
  }
}
