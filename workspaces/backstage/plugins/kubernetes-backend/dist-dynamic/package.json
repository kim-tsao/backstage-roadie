  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "GendocuPublicApis": "npm:gendocu-public-apis@^1.0.0",
    "csstype@npm:^3.0.2": "3.0.9",
    "csstype@npm:^3.1.2": "3.0.9",
    "csstype@npm:^3.1.3": "3.0.9",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "@backstage/plugin-catalog-node": "2.2.2",
    "@backstage/plugin-catalog-common": "1.1.10",
    "@backstage/plugin-kubernetes-common": "file:./embedded/backstage-plugin-kubernetes-common",
    "@backstage/plugin-kubernetes-node": "file:./embedded/backstage-plugin-kubernetes-node"
